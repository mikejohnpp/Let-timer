# Domain for automatic HTTPS with Caddy (e.g. timer.example.com or localhost)
DOMAIN=timer.example.com

# Initial API token for the daemon (bootstrap token created on initial launch)
LET_TIMER_BOOTSTRAP_TOKEN=lt_bootstrap_secret_token_12345

# HTTP server binding (default: 0.0.0.0:8765 in container)
LET_TIMER_LISTEN=0.0.0.0:8765

# Allowed Host headers (comma-separated, prevents DNS rebinding)
# On non-loopback interfaces, requests with unlisted Host headers are rejected with 421.
LET_TIMER_ALLOWED_HOSTS=timer.example.com,localhost,127.0.0.1

# Allowed CORS origins (comma-separated; omit for same-origin only)
# LET_TIMER_CORS_ORIGINS=https://timer.example.com

# Development mode: set to 1 to allow localhost Vite dev origins (http://localhost:5173, etc.)
LET_TIMER_DEV=0

# API Documentation: set to 1 to enable /swagger-ui on non-loopback (default: 0 / loopback only)
LET_TIMER_ENABLE_DOCS=0

# Trusted reverse proxy: set to 1 when running behind Caddy / Nginx
# Enables client IP extraction from X-Forwarded-For for audit logs and rate limiting.
LET_TIMER_TRUSTED_PROXY=1

# Maximum media upload size in MB (default: 200)
LET_TIMER_MAX_UPLOAD_MB=200

# Custom media storage directory (default: /data/medias in Docker)
# LET_TIMER_MEDIA_DIR=/data/medias

# Notification provider: desktop, log, ntfy, webhook
LET_TIMER_NOTIFY=ntfy
LET_TIMER_NTFY_URL=https://ntfy.sh/my-private-lt-topic

# Server Timezone (e.g. Asia/Ho_Chi_Minh, UTC, America/New_York)
LET_TIMER_TIMEZONE=UTC

# Litestream S3 / Cloudflare R2 backup configuration (optional, profile: backup)
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
