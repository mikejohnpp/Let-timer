# Domain for automatic HTTPS with Caddy (e.g. timer.example.com or localhost)
DOMAIN=timer.example.com

# Initial API token for the daemon (bootstrap token created on initial launch)
LET_TIMER_BOOTSTRAP_TOKEN=lt_bootstrap_secret_token_12345

# Notification provider: desktop, log, ntfy, webhook
LET_TIMER_NOTIFY=ntfy
LET_TIMER_NTFY_URL=https://ntfy.sh/my-private-lt-topic

# Server Timezone (e.g. Asia/Ho_Chi_Minh, UTC, America/New_York)
LET_TIMER_TIMEZONE=UTC

# Litestream S3 / Cloudflare R2 backup configuration (optional, profile: backup)
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
